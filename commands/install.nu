# Printing is the default for the jj aliases because that file is often
# generated by a dotfile manager, where a write is either impossible or
# reverted on the next rebuild. Git hooks have no such problem: they live in
# .git, which nothing else generates, so there they are written.

const LIB = path self "../lib"
use $"($LIB)/log.nu" *
use $"($LIB)/git.nu"
use $"($LIB)/vcs.nu"

const HOOKS = ["pre-push" "commit-msg"]
const MARKER = "# jj-ci — written by `jj-ci install`."

export def invoke [
  bin: string # absolute path to bin/jj-ci
  self_cmd: list<string> # how to re-invoke jj-ci, interpreter included
  format: string # toml | nix | both
  on_path: bool # emit the bare name instead of an absolute path
  write: bool
  backend: string
]: nothing -> int {
  # Outside a repository there is nothing to detect and nothing to install
  # into, but the aliases are still worth printing.
  let which = (try { vcs backend $backend } catch { "jj" })
  if $which == "git" { return (hooks $self_cmd) }

  let cmd = (if $on_path { "jj-ci" } else { $bin })

  if $write {
    return (write-user-config $cmd)
  }

  if $format in ["toml" "both"] { print (toml-block $cmd) }
  if $format == "both" { print "" }
  if $format in ["nix" "both"] { print (nix-block $cmd) }
  0
}

def hooks [self_cmd: list<string>]: nothing -> int {
  let repo = (vcs detect "git")
  let dir = (git hooks-dir $repo.root $repo.git_dir)
  mkdir $dir

  let blocked = (
    $HOOKS
    | each { |name| { name: $name, path: ($dir | path join $name) } }
    | where { |h| ($h.path | path exists) and not (ours $h.path) }
  )
  if ($blocked | is-not-empty) {
    err ($"($dir) already has a ($blocked | get name | str join ' and ') hook that jj-ci did not write."
      + "\nAdd these lines to it yourself, or move it aside and run this again:")
    for h in $blocked { print ""; print (body $h.name $self_cmd) }
    return 1
  }

  for name in $HOOKS {
    let dest = ($dir | path join $name)
    (body $name $self_cmd) | save --force --raw $dest
    chmod +x $dest
  }

  print $"(ansi green)✓(ansi reset) wrote ($HOOKS | str join ' and ') to ($dir)"
  info "`git push` now runs the push stage over what it would publish"
  info "the commit-msg hook runs every description check against the message"
  0
}

# The interpreter is named by absolute path because a git hook inherits
# whatever environment the client that spawned it had, and a GUI client
# usually has none of the user's PATH.
def body [name: string, self_cmd: list<string>]: nothing -> string {
  let argv = ($self_cmd | each { |a| $'"($a)"' } | str join " ")
  let tail = (if $name == "commit-msg" { ' "$1"' } else { "" })
  ([
    "#!/bin/sh"
    $"($MARKER) Delete this file to remove the gate."
    $"exec ($argv) hook ($name)($tail)"
  ] | str join "\n") + "\n"
}

# Only a hook carrying the line this writes: a husky hook that happens to
# mention jj-ci is still someone else's.
def ours [path: string]: nothing -> bool {
  (open --raw $path) | str contains $MARKER
}

def toml-block [cmd: string]: nothing -> string {
  r#'
# ~/.config/jj/config.toml
[aliases]
ci = ["util", "exec", "--", "@CMD@", "ci"]
push = ["util", "exec", "--", "@CMD@", "push"]'#
  | str trim --left
  | str replace --all "@CMD@" $cmd
}

def nix-block [cmd: string]: nothing -> string {
  r#'
# home-manager
programs.jujutsu.settings.aliases = {
  ci = [ "util" "exec" "--" "@CMD@" "ci" ];
  push = [ "util" "exec" "--" "@CMD@" "push" ];
};

# Nushell completions for those two aliases. jj generates its own the same way,
# and it cannot know about aliases, so this is a second file beside it.
home.activation.jjCiNushellCompletions = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
  mkdir -p "$HOME/.config/nushell/completions"
  @CMD@ completions nushell > "$HOME/.config/nushell/completions/jj-ci.nu"
'';

# …and, beside the line that sources jj.nu:
#   source ~/.config/nushell/completions/jj-ci.nu'#
  | str trim --left
  | str replace --all "@CMD@" $cmd
}

def write-user-config [cmd: string]: nothing -> int {
  let target = (^jj config path --user | str trim)
  if ($target | path type) == "symlink" {
    err $"($target) is a symlink — it is generated by a dotfile manager, and writing here would be lost."
    info "run `jj-ci install --format nix` and put the result in your configuration instead"
    return 1
  }
  for sub in ["ci" "push"] {
    let definition = (
      r#'["util", "exec", "--", "@CMD@", "@SUB@"]'#
      | str replace --all "@CMD@" $cmd
      | str replace --all "@SUB@" $sub
    )
    let r = (^jj config set --user $"aliases.($sub)" $definition | complete)
    if $r.exit_code != 0 {
      err ($r.stderr | str trim)
      return 1
    }
  }
  print $"(ansi green)✓(ansi reset) aliases ci and push written to ($target)"
  info "jj push now gates every repository that has a .jj-ci.toml"
  0
}
